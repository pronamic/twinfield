	"abandoned": "solvebeam/twinfield",
	"homepage": "http://pronamic.nl",
	"license": "GPL",
	"authors": [
		{"name": "Remco Tolsma", "email": "remcotolsma@pronamic.nl"},
		{"name": "Leon Rowland", "email": "leon@pronamic.nl"}
